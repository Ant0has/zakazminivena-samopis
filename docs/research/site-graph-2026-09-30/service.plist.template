<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ru.zakazminivena.site-graph</string>
  <key>ProgramArguments</key><array>
    <string>__NODE_BINARY__</string>
    <string>__GRAPH_DIRECTORY__/serve.cjs</string>
  </array>
  <key>WorkingDirectory</key><string>__GRAPH_DIRECTORY__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>StandardOutPath</key><string>/private/tmp/zm-site-graph-launchd.out.log</string>
  <key>StandardErrorPath</key><string>/private/tmp/zm-site-graph-launchd.err.log</string>
</dict></plist>
